name "uim-domains"
description "An domain-driven framework for D programming language. It provides a set of tools and libraries to build applications based on the principles of Domain-Driven Design (DDD)."
homepage "https://www.sueel.de/uim/framework"
authors "Ozan Nurettin Süel" "UI Manufaktur"
copyright "Copyright © 2018-2026, Ozan Nurettin Süel"
license "Apache-2.0"

// Target
targetType "library"
targetName "uim-domains"

// External dependencies
dependency "dlib" version="~>1.4.1"
dependency "colored" version="~>0.0.31"
dependency "vibe-d" version="~>0.10.3"
dependency "dyaml" version="~>0.10.0"
dependency "uim-framework" version="~>26.11.1"

// uim dependencies
dependency ":domain" version="*"
// dependency ":hcm" version="*"

sourceFiles "./source/uim/domains/*"

// Subpackages
// subPackage "hcm"
subPackage "domain"

buildRequirements "allowWarnings" "silenceDeprecations"
buildOptions "ignoreDeprecations" "debugInfo"